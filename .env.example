# Project Settings -> Data API (ou "API") no painel do Supabase
BEACH_API_SUPABASE_URL=https://SEUPROJETO.supabase.co
# Use a "service_role" key (NUNCA exponha essa chave no app mobile -- ela
# só deve viver no backend/servidor. O app mobile fala com a SUA api,
# não direto com a Supabase.)
BEACH_API_SUPABASE_KEY=sua_service_role_key_aqui

BEACH_API_NOAA_HTTP_TIMEOUT_SECONDS=10.0
